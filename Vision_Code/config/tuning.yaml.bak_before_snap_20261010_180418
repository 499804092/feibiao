%YAML:1.0
# ============================================================================
#  飞镖视觉 —— 全部可调参数（本工程唯一的调参文件）
# ----------------------------------------------------------------------------
#  【这个文件是什么】
#    以前参数散在 config/json/ 里的 detect.json / sensors.json / track.json
#    三个文件，调一次要来回翻。现在全部合并到这里，改完直接生效，不用重编译。
#
#  【怎么改】
#    1) 直接编辑本文件保存 → 程序下一帧就会读到新值（跟踪线程每秒自动重载一次）
#    2) 或者跑 uvc_color_view 实时调，按 g 打印，粘回本文件
#
#  【格式说明】
#    用的是 YAML（不是 JSON），因为 YAML 支持 # 注释 —— 每个参数下面都能写清楚
#    "调大调小会怎样"。缩进必须用【空格】，绝对不能用 Tab。
#    冒号后面必须有一个空格，例如   h_min: 40   （不能写成 h_min:40）
#
#  【改完怎么确认生效】
#    程序启动时会打印一行 [ColorDetector] ...，那就是实际读进去的值。
#    只有 detect.json 里的参数会打印，其它的看对应模块的启动输出。
# ============================================================================


# ============================================================================
# 一、相机（UVC 免驱摄像头）
# ============================================================================
uvc:
  device: 0                  # /dev/videoN 的 N。板子上一般是 0
  width:  640               # 采集宽度(像素)。↓小=更快更省内存，但远距离目标像素少
  height: 480               # 采集高度(像素)。和 width 一起决定处理量，是最影响帧率的参数
  fps: 60                    # 请求帧率。★注意这块新相机(Sunplus DHZJ 1bcf:28c4)★
                             #   1280x720 下 MJPG 只报了一档 250fps、YUYV 只有 10fps，
                             #   所以 60 只是"期望值"，真正生效多少看启动时打印的那行
                             #   [UvcCamera] 请求 ... 实际生效 ...
  mjpg: 1                    # 1=MJPG（高帧率必须用这个）  0=YUYV（1280x720 只有 10fps，别用）
  orientation: 2             # 画面朝向修正（相机装反了就改这里）
                             #   0=不转 1=顺90° 2=转180° 3=逆90° 4=水平镜像 5=垂直镜像

  # ---- 曝光 / 增益 / 亮度 ----
  #   ⚠️ 写这些参数会【打断正在跑的取流】（实测写完立刻 select() timeout）
  #   所以 enable 默认 0：完全不动相机，用驱动自己的自动曝光
  exposure:
    enable: 0                # 0=完全不碰相机（安全默认）  1=启动时按下面的值设置一次
    auto: 1                  # 1=手动  3=自动。★想用手动曝光这里必须写 1，否则 value 会被驱动忽略
    value: 100               # 手动曝光，单位 100µs。↓小=画面更暗但噪点少、运动模糊小
                             #   （引导灯是发光体，压暗背景能让识别更稳）
    gain: -1                 # 增益。↓小=噪点少但更暗。-1 = 不动
    brightness: -1           # 亮度。↓小=更暗。-1 = 不动。想调暗画面优先用这个（不影响取流）
    backlight: -1            # 背光补偿。-1 = 不动


# ============================================================================
# 二、串口（和 STM32 飞控通信）
# ============================================================================
serialport:
  port: "/dev/ttyUSB"        # 设备名。板子上可能是 /dev/ttyUSB0 或 /dev/ttyACM0
  baudrate: 460800           # 波特率，必须和飞控端一致
  databits: 8                # 数据位
  stopbits: 1                # 停止位
  parity: "N"                # 校验：N=无
  optional: 1                # ★1 = 无飞控测试模式：串口打不开也继续跑（不报错、不发数据）
                             #   0 = 正式比赛模式：串口打不开直接退出
                             #   ⚠️ 比赛前必须改回 0！


# ============================================================================
# 三、识别：HSV 颜色分割 + 形状筛选（最常调的部分）
# ============================================================================
color:
  # ---- HSV 绿色阈值（OpenCV 的 8 位图：H 0~179，S/V 0~255）----
  h_min: 40                  # 色调下限。实测引导灯的绿 H≈53，所以 40 合适
  h_max: 80                  # 色调上限。↓收窄=只认更纯的绿，能滤掉偏黄/偏青的东西
  s_min: 60                  # 饱和度下限。↓小=能认更灰的绿（但也更容易误识别）
                             #   ⚠️ 不要调太高：引导灯【灯芯过曝后 S 只有 21】，
                             #      调高会把灯芯切掉（虽然代码会填洞补救，但边界会变差）
  s_max: 255                 # 饱和度上限，一般拉满
  v_min: 60                  # 亮度下限。↓小=能认更暗的绿（光线差时调它）
  v_max: 255                 # 亮度上限，一般拉满

  # ---- 形状筛选 ----
  aspect_max: 1.60           # 外接矩形长宽比上限（长边÷短边）。
                             #   ↓小=更严格（只认接近圆的），但光晕扩散时会滤掉真目标
                             #   ↑大=更宽松（灯带、长条绿标志也会被算进来）
  extent_min: 0.45           # 填充率下限 = 轮廓面积÷外接矩形面积。
                             #   实心光斑实测 0.70~0.76，所以 0.45 有余量。
                             #   ↓小=更宽松   ↑大=更严格（滤掉断裂碎块、细长灯带）
                             #   0 = 关闭这道筛选
  circularity_min: 0.0       # 圆度下限 = 4π·面积/周长²。★默认 0 = 关闭★
                             #   为什么关：发光光斑边界毛糙，圆度实测在 0.29~0.57
                             #   之间乱跳，取任何阈值都不可靠。用 extent_min 代替它
  min_area: 5                # 轮廓面积下限(像素²)。↓小=能认更远的小目标（但噪点更多）
                             #   ↑大=滤噪点，但可能漏掉远距离的灯
  ref_area: 2000.0           # 面积归一化基准：面积达到这个值算"满分 1.0"（只影响打印的 score）
  max_targets: 1             # 最多返回几个目标。算法只要面积最大的 1 个
  morph_size: 0              # 形态学核大小。★建议保持 0★
  # ---- 【新增 2026-10-06】掩膜硬化 + 门内自适应亮度切分 ----
  use_hull: 1                # 凸包硬化：算面积/填充率/圆度时先用 convexHull 把轮廓"包实"。
                             #   解决什么：第 4 步填洞靠"重画最外层轮廓"，但如果绿环上有
                             #   一像素漏缝，RETR_EXTERNAL 会顺着外圈绕进洞里，得到一条
                             #   自相交的细带子（实测外接框 29x38 而面积只有 196），重画
                             #   出来仍是空心环 → 填充率 0.18 → 被 extent_min 判死、目标
                             #   整个丢失（真机实拍帧 v_min>=140 就是这样死的）。
                             #   凸包是超集，只会救回"因空心被误杀"的候选，不会误杀。
                             #   ★只影响判据，不影响外接框和质心★ → 掩膜尺寸不变。
                             #   1=开  0=关（关掉就退回改动前的行为）
  v_ref_ratio: 0.60          # 门内自适应亮度切分比例。★0 = 关闭★
                             #   要解决什么：引导灯的绿光会照亮它周围的机壳，那一片
                             #   【也是绿的、只是暗】，于是和灯连成一整块近方形的掩膜
                             #   （实测 180x118，长宽比 1.53，离 aspect_max=1.60 只差 5%）。
                             #   后果：① 外接框被撑大 → 测距用的像素宽度失真；
                             #        ② 贴着判据上限，光晕再散一点就整个丢目标。
                             #   为什么用比例而不是调高 v_min：光晕的绝对亮度随距离/曝光
                             #   变化很大，固定阈值调高了远/暗时灯本身也被切掉（实测真机帧
                             #   v_min>=140 就丢目标），调低了近/过曝时光晕又全进来。
                             #   实测效果：赛场引导灯照片 180x118(1.53) → 75x68(1.10 正圆)
  v_ref_s_min: 20            # 细化时放行的饱和度下限。过曝的灯芯 S 只有 2~30，卡在
                             #   s_min=60 外面进不来；不放它进来就只切出绿环、中间是洞。
                             #   放宽是【安全】的：整块已被严格绿门框住，不会误检。
  v_ref_min_area: 60         # 门内最大连通块小于这个面积(px²)就不做细化。
                             #   防止把无灯画面上的杂散小绿点"养大"成假目标
                             #   （实测不加这道闸时，无灯帧上出现过 6x6 的假目标）。
                             #   物理上也合理：光晕撑大掩膜只在灯近/亮/大时才发生。
                             #   开闭运算会把引导灯和下方的绿色标志【粘成一整块】，
                             #   实测 21x21 时外接框从 51x55 变成 191x177，直接识别失败

  # ---- ROI：只处理画面某个高度区间（按高度的比例 0~1）----
  roi_top: 0.0               # 上边界。0.0 = 从画面最顶上开始
  roi_bottom: 1.0            # 下边界。1.0 = 到最底下（0.0/1.0 就是全图）
                             #   赛场画面上下有干扰（灯、反光）时，裁掉能显著减少误识别


# ============================================================================
# 四、看画面：本地窗口 + 网页推流
# ----------------------------------------------------------------------------
#   ★两种看画面的方式，互不影响，可以任意组合★
#     · 虚拟机 / 有桌面的电脑：开 view.enable，弹窗口
#     · 开发板（只有终端、没桌面）：关 view.enable、开 web.enable，
#       然后用电脑浏览器打开  http://<板子IP>:8080/   看画面
#
#   两条路的区别：本地窗口是"坐在机器前面看"，网页推流是"远程看"。
#   推流推的是【画好识别框和解算结果】的画面，不是原始画面 ——
#   所以远程也能看出"识别到没有、角度对不对"。
# ============================================================================
view:
  enable: 1                # 1=开本地窗口  0=不开
                             #   ★不用为了板子改这一项★
                             #   程序启动时会自动检测这台机器有没有图形界面：
                             #     · 虚拟机/有桌面  → 正常弹窗口
                             #     · 开发板/SSH 登录 → DISPLAY 为空 → 自动关掉窗口，
                             #       不会因为"没桌面"而崩（imshow 抛的异常会被接住）
                             #   所以同一个二进制在两种机器上都能直接跑。
  mask: 0                    # 1=启动时掩膜窗口就已经打开  0=关着（运行时按 m 随时切）

# ---- 网页推流（MJPEG over HTTP）----
#   浏览器直接打开  http://<板子IP>:8080/   即可，不用装任何插件。
#   查板子 IP：在板子上敲  hostname -I
web:
  enable: 1                  # 1=启动推流服务器  0=不推流（★板子上要设 1★）
  port: 8080                 # 端口。被占用了就换一个（比如 8081）
  fps: 15                    # ★推流帧率 = 画面延迟的主要来源★
                             #   延迟大约是 1/fps：15fps→平均多 33ms、最坏 66ms；
                             #   25fps→平均 20ms、最坏 40ms。
                             #   但帧率越高，板子 CPU 越吃力（每帧都要编 JPEG）。
                             #   RK3566 上 25fps + 640 宽是"流畅度"和"负载"比较好的折中；
                             #   如果发现识别帧率掉了，先把这个降到 15 试试。
  quality: 70                # JPEG 质量 1~100。↑大=清晰但每帧更大
                             #   640 宽 + 质量 70 时每帧约 30KB，25fps ≈ 750KB/s
  width: 480                 # 推流画面宽度（0 = 不缩放，用原始尺寸）。
                             #   缩小能成倍省下 JPEG 编码时间，RK3566 上编码是大头。
                             #   ★这是"负载"和"看清细节"的旋钮★：降到 480 能明显减负


# ============================================================================
# 五、跟踪状态机（决定"什么时候算找到了目标"）
# ============================================================================
selection:
  min_found_frame: 0.7    # 从"丢失"状态连续命中多少秒才认为"找到了"。
                             #   ↑大=更不容易被误检骗到，但反应慢
  limit_found_frame: 1.5     # 命中计时的上限（封顶值）
  max_drop_frame: 1.0        # 丢帧计时达到多少秒就判定目标丢失。
                             #   ↑大=更容忍短暂遮挡（但目标真没了也会多跟一会儿）
  limit_drop_frame: 1.5      # 丢帧计时的上限（封顶值）


# ============================================================================
# 六、一欧元滤波（平滑用，抖动大就调这里）
# ============================================================================
euro:
  min_cut_off: 0.5           # 最小截止频率。↓小=更平滑但【更滞后】（快速运动时拖影）
                             #   ↑大=更跟手但更抖
  beta: 0.5                  # 速度系数。↑大=运动时更跟手（但静止时更抖）
                             #   这是 一欧元滤波 的核心：静时平滑、动时跟手
  d_cut_off: 0.5             # 速度信号的截止频率。↑大=对速度变化反应快，也更容易受噪声影响


# ============================================================================
# 七、相机内参（决定角度解算准不准）
# ----------------------------------------------------------------------------
#   ★★★ 内参和分辨率是绑死的 ★★★
#   这组数是【实测标定】出来的，只对 640x480 有效。
#   改了上面 uvc.width/height 就必须重新标定，否则 yaw/pitch 会整体偏掉。
#
#   【标定信息】
#     相机       DF-10-200W（大凡视觉，1bcf:28c4，全局快门，USB2.0）
#     标定板     大凡 Q12-340-25（内角点 11x8，方格 25mm）
#     分辨率     640x480（★这颗相机在低分辨率下是【居中裁切】不是缩放★
#                 所以 fx 和 720p 时几乎一样，视场角却窄了很多）
#     有效图片   47 张
#     重投影误差 RMS 0.15 px（最差单张 0.25 px，47 张全部 <0.3px）
#     标定日期   2026-10-04
#
#   【这组数可不可信 —— 三项独立交叉验证都过了】
#     · fx/fy 只差 0.06%                    → 像素是方的，正常
#     · cx 323.86 vs 画面中心 320           → 差 3.9px，很好
#     · 和 720p 那套标定互相印证：按"居中裁切"模型从 720p 反推，
#       640x480 应该解出 cx=321.3 / cy=207.8，实测 323.9 / 204.3
#       —— 两次完全独立的标定只差 2.6px / 3.5px，说明两边都是对的
#     · C++ 和 Python 两个独立实现跑出来逐位相同（RMS 都是 0.1539）
#
#   【畸变】实测这颗镜头【确实有畸变】—— 在 720p 上做过对照实验：
#     把畸变锁成 0 会让重投影误差从 0.22px 涨到 0.57px（+157%）。
#     所以镜头图纸上那句「无畸变」是宣传话术，别信。
#     注：Track.cpp 的解算目前没用去畸变，所以畸变系数没写进这里。
#
#   【以后重新标定】
#     cd ~/Desktop/feibiao/calib_usb
#     rm -f calib_out/*.jpg calib_out/intrinsics.yaml
#     GDK_BACKEND=x11 DISPLAY=:0 ./calib_capture_usb     # 手动按 s，不要用 --auto
#     cd ~/Desktop/feibiao/beifen/verify
#     python3 diag_calib_views.py ~/Desktop/feibiao/calib_usb/calib_out   # 先体检
#     cd ~/Desktop/feibiao/calib_usb && ./calib_camera_usb
# ============================================================================
camera:
  fx: 676.41                 # 水平焦距(像素)。★直接决定 yaw 的数值大小★
  fy: 676.30                 # 垂直焦距(像素)。影响 pitch 的数值大小
                             #   （和 fx 只差 0.06%，说明像素是方的，正常）
  cx: 323.86                 # 光心 x(像素)。yaw 已经不用它，只影响调试打印
  cy: 204.31                 # 光心 y(像素)。★pitch 用它★
                             #   比画面中心(240)高约 36px，是正常的镜头/装配偏差
                             #   （光心在传感器上本来就比几何中心高约 3%，标定把它测出来了）。
                             #   它偏了会给 pitch 带来常值误差 —— 也就是枪口正对
                             #   目标时读不到 0，而是读到一个固定值。


# ============================================================================
# 八、目标真实尺寸（单目测距用，错了距离就一直是错的）
# ----------------------------------------------------------------------------
#   距离 = fx × 下面这个值 ÷ 目标框的像素宽度      所以下面的值错 10%，距离就错 10%
#
#   ★★ 这里要填的是【识别出来的光斑外接框】的尺寸，不是引导灯的物理尺寸 ★★
#      灯芯过曝会往外扩（光晕），所以"有效宽度"通常比实物大。
#      拿卷尺量灯再填进来会偏大 → 解出来的距离偏大。
#
#   【怎么定这个值】用已知距离反推，最准：
#     1) 把目标放在镜头正前方【正好 2.00 米】处，正对
#     2) 跑 Dart，读面板上的 dist 值，记作 Z_c
#     3) 新值 = 当前值 × 2.00 ÷ Z_c
#
#   【实测记录 2026-10-04】
#     原来填 0.15 时，解出来的距离正好是真实距离的 3 倍；
#     改成 0.15 ÷ 3 = 0.05 之后就对上了。
# ============================================================================
target:
  width_m: 0.0275                         # 光斑外接框的有效宽度(米)
  height_m: 0.0336                       # 光斑外接框的有效高度(米)。水平/竖直两个方向取平均，
                             #   所以这两个值要按各自方向分别标定，别只调一个


# ============================================================================
# 九、距离范围（超出范围的解算结果会被丢掉）
# ============================================================================
distance:
  min_m: 0.10                # 下限(米)。↓小=更近也认
                             #   ★原来 0.5：目标一旦进到 50cm 以内，z<0.5 就被
                             #    整条判为无效、距离直接输出 0。现在放宽到 0.10m，
                             #    0 只作为『解算失败』的哨兵值保留。
  max_m: 8.0                 # 上限(米)。↑大=更远也认（但远距离像素太少，解算会很飘）


# ============================================================================
# 十、出厂标定（★平时别动，改了会直接打偏★）
# ============================================================================
# 标定基准文件，记录"枪口对准时目标在画面上的像素 x"。
# 单独一个文件是因为标定时程序会往它【写入】。
ktrack:
  path: "../config/json/ktrack.json"

# 每发飞镖的固定像素补偿（★改了会直接打偏，平时别动★）
#   值 = 瞄点往右偏多少像素（正=右，负=左）
#   ⚠️ 必须写成 group_common / group_shot_N 这种平铺名字，
#      不能写成 group: {"0": ..., "1": ...} 这种嵌套 ——
#      实测 OpenCV 的 YAML 解析器【不支持数字形式的 key】，那种写法直接报错
group_common: 0      # 公共偏移，所有发都加
group_shot_1: 5      # 第 1 发专属偏移
group_shot_2: -6     # 第 2 发
group_shot_3: -4     # 第 3 发
group_shot_4: -6     # 第 4 发
rules: "to right: +, to left: -"   # 只是注释，程序不读
death: -0                          # 程序不读，历史遗留

