// ============================================================================
// uvc_detect_view.cpp —— 打开摄像头 + 实时目标检测 + 画面显示（带检测框）
// ----------------------------------------------------------------------------
// 这个程序把"相机取图"和"模型推理"串起来，直接在画面上画检测框，
// 用来肉眼确认：模型到底能不能认出你要找的目标（比如绿色引导灯）。
//
// 【它跑的就是工程里的那条链路】
//   相机取图(640x480, MJPG)
//     → letterBox 缩放到网络输入(640x384 画布)
//     → 模型推理（预处理 BGR→RGB、/255，与 OpenvinoInfer 一致）
//     → 取 output[0]，形状 (1,15120,27)
//     → 解析 4(框) + 9(类别) + 4(颜色)
//     → 把框画回原图
//
// 【用法】
//   ./uvc_detect_view                                  # 默认模型路径 + /dev/video0
//   ./uvc_detect_view --no-model                       # 只看画面，不跑检测
//   ./uvc_detect_view --thr 0.3                        # 调低检测阈值
//   ./uvc_detect_view --orientation 2                   # 画面朝向修正(0~5)
//   ./uvc_detect_view --headless --seconds 20           # 无窗口，只统计并打印
//   ./uvc_detect_view --xml a.xml --bin a.bin           # 指定模型
//
// 【曝光调参 —— 新增】
//   默认会从 Vision_Code/config/json/sensors.json 的 uvc.exposure 读曝光设置，
//   所以配置里改了值，这里不用加任何参数就直接生效（和工程 Dart 行为一致）。
//   ./uvc_detect_view --list-ctrls                      # 只列出相机可调项和范围，不打开画面
//   ./uvc_detect_view --orientation 2 --thr 0.20        # 用 sensors.json 里的曝光值
//   ./uvc_detect_view --auto-exp 1 --exposure 80        # 手动曝光 80（越小越暗、噪声越少）
//   ./uvc_detect_view --no-cfg                          # 忽略配置，用相机当前状态
//   ./uvc_detect_view --config 别的.json                # 换一个配置文件读
//   优先级：命令行参数 > 配置文件
//
// 【键盘】q/ESC 退出 | s 存图 | o 切换朝向 | i 打印帧率 | t 调阈值
//         [  ]  曝光 -10 / +10（自动切到手动模式）
//         -  =  增益 -1  / +1
//         a      在「自动曝光 / 手动曝光」之间切换
//         c      打印相机全部可调项与范围（调参前先看这个）
// ============================================================================

